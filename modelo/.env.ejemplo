# Credenciales para leer las tablas de Databricks desde un computador (fuera de Databricks).
# 1) Copiar este archivo como ".env" en la misma carpeta del notebook.
# 2) Llenar los tres valores. NO entregar ni subir el archivo .env (ya está en .gitignore).
#
# Dónde se encuentran (Databricks → SQL Warehouses → el warehouse → Connection details):
#   Server hostname, HTTP path. El token: icono de usuario → Settings → Developer → Access tokens → Generate new token.
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opcional: "auto" (por defecto), "databricks" (obliga a leer de Databricks) o "local" (solo archivos de data/)
# FUENTE_DATOS=databricks
